  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: Pola candlestick yang menunjukkan dua candlestick dengan warna hijau-merah
    dengan candle pertama yang berwarna hijau dan candle kedua yang berwarna merah
    dengan bentuk candle hijau yang kuat yang diikuti candle merah yang memiliki
    open lebih tinggi namun close lebih rendah dari candle hijau sebelumnya. Pola
    Dark Cloud Cover biasanya menunjukkan pembalikan dari tren naik karena seringkali
    menjadi titik paling tinggi
  m_isRightToLeft: 0
